# Local SQLite database. Omit DATABASE_URL to use backend/se_maestro.db.
# DATABASE_URL=sqlite:///./se_maestro.db

AI_PROVIDER=gemini
# Set a model identifier that is currently available to your Google AI account.
AI_MODEL=
GEMINI_API_KEY=

# Generated code executes only in pre-pulled Docker images.
LIVE_PYTHON_IMAGE=python:3.12-slim
LIVE_NODE_IMAGE=node:22-slim

# Set your own long random authentication secret, or let the app persist one locally.
# AUTH_SECRET_KEY=
# Keep demonstration behaviour disabled.
# SEED_DEMO_DATA=false
# ENABLE_LEGACY_DEMOS=false
